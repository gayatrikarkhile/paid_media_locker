PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/paid_media_locker
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Short-lived signed URL token for delivering original/preview files
FILE_TOKEN_SECRET=change_this_to_another_long_random_string
FILE_TOKEN_TTL_SECONDS=60

# Starting wallet balance for new users (in coins)
STARTING_BALANCE=100

# Preview generation
PREVIEW_MAX_WIDTH=480
PREVIEW_JPEG_QUALITY=45

# CORS - the origin the Expo app talks to (use * only for local dev)
CORS_ORIGIN=*
